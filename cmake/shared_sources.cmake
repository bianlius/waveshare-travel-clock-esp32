include_guard(GLOBAL)
get_filename_component(_travel_shared_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set_property(GLOBAL PROPERTY TRAVEL_SHARED_ROOT "${_travel_shared_root}")

# Keep the production source list in one data file for IDF and desktop builds.
function(travel_shared_sources output)
    get_property(source_root GLOBAL PROPERTY TRAVEL_SHARED_ROOT)
    set(manifest "${source_root}/main/shared_sources.txt")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    file(STRINGS "${manifest}" entries)
    set(selected)
    foreach(group IN LISTS ARGN)
        set(group_found FALSE)
        foreach(entry IN LISTS entries)
            string(STRIP "${entry}" entry)
            if(NOT entry OR entry MATCHES "^#")
                continue()
            endif()
            if(NOT entry MATCHES "^([a-z_]+)[ \t]+(.+)$")
                message(FATAL_ERROR "Invalid shared source entry: ${entry}")
            endif()
            set(source_group "${CMAKE_MATCH_1}")
            set(source_path "${source_root}/${CMAKE_MATCH_2}")
            if(source_group STREQUAL group)
                set(group_found TRUE)
                if(NOT EXISTS "${source_path}")
                    message(FATAL_ERROR "Missing shared source: ${source_path}")
                endif()
                if(source_path IN_LIST selected)
                    message(FATAL_ERROR "Duplicate shared source: ${source_path}")
                endif()
                list(APPEND selected "${source_path}")
            endif()
        endforeach()
        if(NOT group_found)
            message(FATAL_ERROR "Unknown shared source group: ${group}")
        endif()
    endforeach()
    set(${output} "${selected}" PARENT_SCOPE)
endfunction()
